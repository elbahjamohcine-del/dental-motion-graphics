{
  "name": "dental-motion-graphics",
  "version": "1.0.0",
  "description": "Remotion templates for vertical dental educational videos (Reels / TikTok)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render ExtractionTroisErreurs out/extraction-3-erreurs.mp4",
    "render:all": "node scripts/render-all.mjs",
    "still": "remotion still ExtractionTroisErreurs-Cover out/extraction-3-erreurs-cover.png",
    "preview:docs": "node scripts/make-preview.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run typecheck && npm run lint && node scripts/test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/cli": "4.0.539",
    "@remotion/paths": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "@remotion/zod-types": "4.0.539",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.539",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/eslint-config-flat": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
